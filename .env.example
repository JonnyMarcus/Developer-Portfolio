# ==========================================
# Variáveis de Ambiente - Developer Portfolio
# ==========================================
# Copie para .env.local e preencha os valores
# cp .env.example .env.local
# NUNCA commite .env.local

# URL pública do site (SEO, sitemap, OG images)
NEXT_PUBLIC_SITE_URL=https://seu-dominio.vercel.app

# GitHub API (para seção GitHub Activity)
GITHUB_USERNAME=JonnyMarcus
# Token opcional mas recomendado (aumenta rate limit de 60→5000 req/h)
# Gere em: https://github.com/settings/tokens (scope: public_repo)
GITHUB_TOKEN=

# Formulário de contato (Resend - https://resend.com)
# RESEND_API_KEY=re_xxxxxxxxxxxx
# E-mail que receberá as mensagens do formulário
# CONTACT_TO_EMAIL=seu@email.com

# Opcional: Analytics (Vercel Analytics é automático, não precisa configurar)
# NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
# NEXT_PUBLIC_GA_ID=